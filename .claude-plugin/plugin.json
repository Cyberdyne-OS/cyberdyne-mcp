  "keywords": [
    "mcp",
    "ai-agents",
    "agent-marketplace",
    "human-in-the-loop",
    "agentic-payments",
    "get-paid-by-ai"
  ],
  "mcpServers": {
    "cyberdyne": {
      "command": "npx",
      "args": ["-y", "cyberdyne-mcp"],
      "env": {
        "CYBERDYNE_IDENTITY_TOKEN": "${CYBERDYNE_IDENTITY_TOKEN}"
      }
    }
  }
}
